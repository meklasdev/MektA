{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MektA",
  "patterns": [
    {
      "include": "#tags"
    },
    {
      "include": "#expressions"
    },
    {
      "include": "#comments"
    }
  ],
  "repository": {
    "tags": {
      "patterns": [
        {
          "name": "entity.name.tag.mek",
          "match": "</?[a-zA-Z0-9:-]+"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "name": "string.interpolated.mek",
          "begin": "\\{",
          "end": "\\}"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.mek",
          "begin": "<!--",
          "end": "-->"
        }
      ]
    }
  },
  "scopeName": "source.mek"
}
